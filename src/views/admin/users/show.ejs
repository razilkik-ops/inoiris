<div class="admin-head"><h1><%= user.email %></h1><a href="/admin/users">Назад</a></div>
<section class="admin-card split">
  <div><p><strong>Имя:</strong> <%= user.name %></p><p><strong>Телефон:</strong> <%= user.phone || '—' %></p><p><strong>Адрес:</strong> <%= user.address || '—' %></p></div>
  <div>
    <form method="post" action="/admin/users/<%= user.id %>/role">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Роль<select name="role"><option value="USER" <%= user.role==='USER'?'selected':'' %>>USER</option><option value="ADMIN" <%= user.role==='ADMIN'?'selected':'' %>>ADMIN</option></select></label>
      <button class="button small" type="submit">Изменить роль</button>
    </form>
    <form method="post" action="/admin/users/<%= user.id %>/block">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="button ghost" type="submit"><%= user.isBlocked ? 'Разблокировать' : 'Заблокировать' %></button>
    </form>
  </div>
</section>
<section class="admin-card"><h2>Заказы пользователя</h2><table><tbody><% user.orders.forEach((order) => { %><tr><td>#<%= order.id %></td><td><%= order.status %></td><td><%= formatPrice(order.total) %></td><td><a href="/admin/orders/<%= order.id %>">Открыть</a></td></tr><% }) %></tbody></table></section>
