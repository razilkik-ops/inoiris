<h1>Отзывы</h1>
<section class="admin-card"><table><thead><tr><th>Товар</th><th>Пользователь</th><th>Оценка</th><th>Текст</th><th>Виден</th><th></th></tr></thead><tbody><% reviews.forEach((review) => { %><tr><td><%= review.product.title %></td><td><%= review.user.email %></td><td><%= review.rating %></td><td><%= review.text %></td><td><%= review.isVisible ? 'Да' : 'Нет' %></td><td class="actions"><form method="post" action="/admin/reviews/<%= review.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button" type="submit"><%= review.isVisible ? 'Скрыть' : 'Показать' %></button></form><form method="post" action="/admin/reviews/<%= review.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button danger" type="submit">Удалить</button></form></td></tr><% }) %></tbody></table></section>
