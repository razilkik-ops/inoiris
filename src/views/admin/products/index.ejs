<div class="admin-head"><h1>Товары</h1><a class="button" href="/admin/products/new">Новый товар</a></div>
<section class="admin-card">
  <table>
    <thead><tr><th>Фото</th><th>Название</th><th>Категория</th><th>Цена</th><th>Остаток</th><th>Статус</th><th></th></tr></thead>
    <tbody>
      <% products.forEach((product) => { %>
        <tr>
          <td><img class="thumb" src="<%= product.images[0]?.url || '/uploads/seed-product-1.svg' %>" alt=""></td>
          <td><%= product.title %></td><td><%= product.category.name %></td>
          <td><%= formatPrice(product.salePrice || product.price) %></td>
          <td><%= product.variants.reduce((sum, v) => sum + v.stock, 0) %></td>
          <td><span class="badge"><%= product.isActive ? 'Активен' : 'Скрыт' %></span></td>
          <td class="actions"><a href="/admin/products/<%= product.id %>/edit">Редактировать</a><form method="post" action="/admin/products/<%= product.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button danger" type="submit">Удалить</button></form></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
