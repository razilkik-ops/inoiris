<% const selectedSizes = new Set((product?.variants || []).map((v) => v.sizeId)); const selectedColors = new Set((product?.variants || []).map((v) => v.colorId)); const stockValue = product?.variants?.[0]?.stock ?? 5; %>
<div class="admin-head"><h1><%= product ? 'Редактировать товар' : 'Новый товар' %></h1><a href="/admin/products">Назад</a></div>
<form class="admin-card form-grid" enctype="multipart/form-data" method="post" action="<%= product ? `/admin/products/${product.id}?_csrf=${csrfToken}` : `/admin/products?_csrf=${csrfToken}` %>">
  <label>Название<input name="title" value="<%= product?.title || '' %>" required></label>
  <label>Slug<input name="slug" value="<%= product?.slug || '' %>"></label>
  <label>Цена<input type="number" step="0.01" name="price" value="<%= product?.price || '' %>" required></label>
  <label>Скидочная цена<input type="number" step="0.01" name="salePrice" value="<%= product?.salePrice || '' %>"></label>
  <label>Категория<select name="categoryId"><% categories.forEach((category) => { %><option value="<%= category.id %>" <%= product?.categoryId===category.id?'selected':'' %>><%= category.name %></option><% }) %></select></label>
  <label>Пол<select name="gender"><% ['BOYS','GIRLS','UNISEX'].forEach((g) => { %><option value="<%= g %>" <%= product?.gender===g?'selected':'' %>><%= g %></option><% }) %></select></label>
  <label>Возраст<input name="ageGroup" value="<%= product?.ageGroup || '' %>" required></label>
  <label>Сезон<input name="season" value="<%= product?.season || 'Зима' %>" required></label>
  <label>Материал<input name="material" value="<%= product?.material || '' %>" required></label>
  <label>Температура<input name="temperatureRange" value="<%= product?.temperatureRange || '' %>" required></label>
  <label class="wide">Описание<textarea name="description" required><%= product?.description || '' %></textarea></label>
  <fieldset><legend>Размеры</legend><% sizes.forEach((size) => { %><label class="check"><input type="checkbox" name="sizeIds" value="<%= size.id %>" <%= selectedSizes.has(size.id)?'checked':'' %>> <%= size.name %></label><% }) %></fieldset>
  <fieldset><legend>Цвета</legend><% colors.forEach((color) => { %><label class="check"><input type="checkbox" name="colorIds" value="<%= color.id %>" <%= selectedColors.has(color.id)?'checked':'' %>> <span class="swatch" style="background:<%= color.hex %>"></span><%= color.name %></label><% }) %></fieldset>
  <label>Остаток для выбранных вариантов<input type="number" name="stock" min="0" value="<%= stockValue %>"></label>
  <label>Фото<input type="file" name="images" multiple accept=".jpg,.jpeg,.png,.webp"></label>
  <div class="checks wide">
    <label class="check"><input type="checkbox" name="isActive" <%= !product || product.isActive?'checked':'' %>> Активен</label>
    <label class="check"><input type="checkbox" name="isNew" <%= product?.isNew?'checked':'' %>> Новинка</label>
    <label class="check"><input type="checkbox" name="isBestseller" <%= product?.isBestseller?'checked':'' %>> Хит продаж</label>
  </div>
  <button class="button" type="submit">Сохранить</button>
</form>
<% if (product?.images?.length) { %>
  <section class="admin-card">
    <h2>Фотографии</h2>
    <div class="image-list">
      <% product.images.forEach((image) => { %>
        <form method="post" action="/admin/products/images/<%= image.id %>/delete">
          <img src="<%= image.url %>" alt="">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="button ghost small" type="submit">Удалить</button>
        </form>
      <% }) %>
    </div>
  </section>
<% } %>
