<%
  const displayPhotos = [
    '/uploads/promo-jacket-boys.png',
    '/uploads/promo-jacket-boys.png',
    '/uploads/catalog/midnight-shield.jpg',
    '/uploads/new-arrival-arctic-blue.png'
  ];
  const photoRules = [
    { test: /ботин|сапог|boot|walk|step/i, image: '/uploads/catalog/product-boots.jpg' },
    { test: /шлем|шап|hat|head|bear|cozy/i, image: '/uploads/catalog/product-helmet.jpg' },
    { test: /вареж|перчат|glove|mitten|ice/i, image: '/uploads/catalog/product-gloves.jpg' },
    { test: /термо|layer|soft/i, image: '/uploads/catalog/product-thermal.jpg' },
    { test: /pink|rose|berry|роз|дев|frost/i, image: '/uploads/promo-jacket-girls.png' },
    { test: /forest|green|trail|зел/i, image: '/uploads/promo-jacket-new.png' },
    { test: /arctic/i, image: '/uploads/new-arrival-arctic-blue.png' },
    { test: /snow|patrol|снег/i, image: '/uploads/promo-jacket-boys.png' },
    { test: /nord|polar|син/i, image: '/uploads/promo-jacket-boys.png' }
  ];
  const productPhoto = (item, index = 0, pool = displayPhotos) => {
    const image = item.images?.[0]?.url;
    if (image && !image.includes('seed-product')) return image;
    const key = `${item.slug || ''} ${item.title || ''}`;
    return photoRules.find((rule) => rule.test.test(key))?.image || pool[index % pool.length];
  };
  const primaryPhoto = productPhoto(product);
  const galleryPhotos = [primaryPhoto, ...displayPhotos.filter((photo) => photo !== primaryPhoto)].slice(0, 4);
  const totalStock = product.variants.reduce((sum, variant) => sum + variant.stock, 0);
  const visibleVariants = product.variants.filter((variant) => variant.stock > 0);
  const defaultVariant = visibleVariants[0] || product.variants[0];
  const colors = [...new Map(product.variants.map((variant) => [variant.colorId, variant.color])).values()];
  const sizes = [...new Map(product.variants.map((variant) => [variant.sizeId, variant.size])).values()];
  const relatedPhotos = [
    '/uploads/new-arrival-arctic-blue.png',
    '/uploads/promo-jacket-girls.png',
    '/uploads/catalog/pink-frost.jpg',
    '/uploads/catalog/polar-star.jpg'
  ];
  const variantPayload = product.variants.map((variant) => ({
    id: variant.id,
    sizeId: variant.sizeId,
    colorId: variant.colorId,
    stock: variant.stock
  }));
  const colorRu = (name) => String(name || '').toLowerCase();
%>

<nav class="product-breadcrumbs">
  <a href="/">Главная</a><span>›</span>
  <a href="/catalog?gender=<%= product.gender %>"><%= product.gender === 'BOYS' ? 'Для мальчиков' : product.gender === 'GIRLS' ? 'Для девочек' : 'Унисекс' %></a><span>›</span>
  <a href="/catalog?category=<%= product.categoryId %>"><%= product.category.name %></a><span>›</span>
  <span><%= product.title %></span>
</nav>

<section class="product-detail-page" data-product-detail data-variants='<%- JSON.stringify(variantPayload) %>'>
  <div class="product-detail-gallery">
    <div class="product-main-photo">
      <button type="button" class="gallery-arrow left" data-gallery-prev aria-label="Предыдущее фото">‹</button>
      <img src="<%= galleryPhotos[0] %>" alt="<%= product.title %>" data-main-photo>
      <button type="button" class="gallery-arrow right" data-gallery-next aria-label="Следующее фото">›</button>
    </div>
    <div class="product-thumbs">
      <% galleryPhotos.forEach((photo, index) => { %>
        <button class="<%= index === 0 ? 'active' : '' %>" type="button" data-thumb="<%= index %>"><img src="<%= photo %>" alt=""></button>
      <% }) %>
    </div>
  </div>

  <div class="product-detail-side">
    <div class="product-detail-card">
    <div class="product-card-top">
      <span class="winter-chip"><svg viewBox="0 0 24 24"><path d="M12 2v20M4.5 6.5l15 11M19.5 6.5l-15 11M5 12h14"/></svg><%= product.category.name %></span>
    </div>
    <h1><%= product.title %></h1>
    <p class="product-lead"><%= product.description %></p>

    <div class="product-price-stock">
      <div class="product-detail-price">
        <strong><%= formatPrice(actualPrice(product)) %></strong>
        <% if (product.salePrice && Number(product.salePrice) < Number(product.price)) { %><del><%= formatPrice(product.price) %></del><% } else { %><del><%= formatPrice(Number(product.price) + 30) %></del><% } %>
      </div>
      <div class="stock-mark"><span></span><b>В наличии</b><small><%= totalStock %> шт.</small></div>
    </div>

    <dl class="product-detail-specs">
      <div><span><svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="4"/><path d="M5 21c1.4-4 4.2-6 7-6s5.6 2 7 6"/></svg></span><dt>Пол</dt><dd><%= product.gender %></dd></div>
      <div><span><svg viewBox="0 0 24 24"><path d="M7 4h10v16H7z"/><path d="M9 8h6M9 12h6"/></svg></span><dt>Материал</dt><dd><%= product.material %></dd></div>
      <div><span><svg viewBox="0 0 24 24"><path d="M7 3v4M17 3v4M4 8h16M5 5h14v15H5z"/></svg></span><dt>Возраст</dt><dd><%= product.ageGroup %></dd></div>
      <div><span><svg viewBox="0 0 24 24"><path d="M10 14.4V5a2 2 0 0 1 4 0v9.4a5 5 0 1 1-4 0Z"/></svg></span><dt>Температура</dt><dd><%= product.temperatureRange %></dd></div>
    </dl>

    <form method="post" action="/cart/add" class="product-buy-panel">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="productId" value="<%= product.id %>">
      <input type="hidden" name="variantId" value="<%= defaultVariant?.id || '' %>" data-variant-id>

      <div class="product-option-grid">
        <fieldset class="product-color-options">
          <legend>Цвет</legend>
          <% colors.forEach((color, index) => { %>
            <label>
              <input type="radio" name="uiColor" value="<%= color.id %>" <%= defaultVariant?.colorId === color.id || (!defaultVariant && index === 0) ? 'checked' : '' %>>
              <span style="--swatch:<%= color.hex %>"></span>
              <small><%= colorRu(color.name) %></small>
            </label>
          <% }) %>
        </fieldset>

        <fieldset class="product-size-options">
          <legend>Размер</legend>
          <% sizes.forEach((size, index) => { %>
            <label>
              <input type="radio" name="uiSize" value="<%= size.id %>" <%= defaultVariant?.sizeId === size.id || (!defaultVariant && index === 0) ? 'checked' : '' %>>
              <span><%= size.name %></span>
            </label>
          <% }) %>
        </fieldset>
      </div>

      <label class="product-quantity">Количество
        <span>
          <button type="button" data-qty-minus>−</button>
          <input type="number" name="quantity" value="1" min="1" max="<%= defaultVariant?.stock || 1 %>" data-qty-input>
          <button type="button" data-qty-plus>+</button>
        </span>
      </label>

      <div class="product-actions-row">
        <button class="product-cart-button" type="submit">
          <svg viewBox="0 0 24 24"><path d="M7 8h10l1 13H6L7 8Z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>
          Добавить в корзину
        </button>
        <% if (currentUser) { %>
          <button class="product-favorite-button" type="submit" form="favorite-form">♡ В избранное</button>
        <% } else { %>
          <a class="product-favorite-button" href="/login">♡ В избранное</a>
        <% } %>
      </div>
    </form>

    <% if (currentUser) { %>
      <form id="favorite-form" method="post" action="/favorites/add">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="productId" value="<%= product.id %>">
      </form>
    <% } %>
    </div>

    <section class="product-feature-strip">
      <div><span class="pf-icon"><svg viewBox="0 0 24 24"><path d="M12 3C8 8 6 11 6 15a6 6 0 0 0 12 0c0-4-2-7-6-12Z"/></svg></span><b>Водонепроницаемая</b></div>
      <div><span class="pf-icon"><svg viewBox="0 0 24 24"><path d="M4 8c4-3 8 3 12 0 1-.8 2-1.3 4-1.3M4 14c4-3 8 3 12 0 1-.8 2-1.3 4-1.3"/></svg></span><b>Дышащая</b></div>
      <div><span class="pf-icon"><svg viewBox="0 0 24 24"><path d="M20 4C12 4 6 8.8 6 16.5c0 1.1.3 2.2.8 3.1C13.5 19.1 19 13.4 20 4Z"/></svg></span><b>Лёгкая</b></div>
      <div><span class="pf-icon"><svg viewBox="0 0 24 24"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/></svg></span><b>Светоотражающие элементы</b></div>
    </section>

    <section class="product-service-strip">
      <div><span class="ps-icon"><svg viewBox="0 0 48 48"><path d="M7 17h22v16H7z"/><path d="M29 22h7l5 6v5H29z"/><circle cx="15" cy="36" r="4"/><circle cx="35" cy="36" r="4"/></svg></span><b>Быстрая доставка</b><span>По всей Беларуси</span></div>
      <div><span class="ps-icon"><svg viewBox="0 0 48 48"><path d="M40 22A16 16 0 0 0 13 11l-5 5"/><path d="M8 7v9h9"/><path d="M8 26a16 16 0 0 0 27 11l5-5"/><path d="M40 41v-9h-9"/></svg></span><b>Обмен 14 дней</b><span>Лёгкий возврат</span></div>
      <div><span class="ps-icon"><svg viewBox="0 0 48 48"><path d="m24 5 5.2 6 8-.8.8 8 6 5.8-6 5.8-.8 8-8-.8-5.2 6-5.2-6-8 .8-.8-8-6-5.8 6-5.8.8-8 8 .8L24 5Z"/><path d="m16.5 24.5 5 5L32 18"/></svg></span><b>Гарантия качества</b><span>Премиальные материалы</span></div>
    </section>
  </div>
</section>

<% if (related.length) { %>
  <section class="related-products">
    <div class="related-head">
      <h2>
        <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 5v38M9 14l30 20M39 14 9 34M16 6l8 8 8-8M16 42l8-8 8 8M5 24h38M8 18l8 6-8 6M40 18l-8 6 8 6" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Похожие товары
      </h2>
      <a href="/catalog">Смотреть все <span>→</span></a>
    </div>
    <div class="related-grid">
      <% related.slice(0, 4).forEach((item, index) => { const relatedPhoto = productPhoto(item, index, relatedPhotos); %>
        <article class="related-card">
          <a class="related-photo" href="/products/<%= item.slug %>">
            <img src="<%= relatedPhoto %>" alt="<%= item.title %>" loading="lazy" decoding="async">
          </a>
          <span class="related-badge <%= item.isBestseller ? 'hit' : '' %>"><%= item.isBestseller ? 'Хит' : 'Новинка' %></span>
          <a class="related-heart" href="<%= currentUser ? '/favorites' : '/login' %>" aria-label="В избранное">♡</a>
          <div class="related-body">
            <a class="related-title" href="/products/<%= item.slug %>"><%= item.title %></a>
            <p><%= item.category?.name || 'Верхняя одежда' %></p>
            <div class="related-price">
              <strong><%= formatPrice(actualPrice(item)) %></strong>
              <% if (item.salePrice && Number(item.salePrice) < Number(item.price)) { %><del><%= formatPrice(item.price) %></del><% } %>
              <a href="/products/<%= item.slug %>" aria-label="Открыть товар">→</a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
<% } %>
