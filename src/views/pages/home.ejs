<section class="wk-hero" data-hero-slider>
  <div class="wk-hero-copy">
    <div class="wk-pill">
      <svg viewBox="0 0 24 24"><path d="M12 2v20M4.5 6.5l15 11M19.5 6.5l-15 11M5 12h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      <span>Зимние куртки для детей</span>
    </div>
    <h1 data-hero-title>Тепло, стиль<br>и свобода<br>движения</h1>
    <p data-hero-text>Премиальные зимние куртки для детей от 2 до 14 лет. Защита от холода, ветра и влаги в любую погоду.</p>
    <a class="wk-cta" href="/catalog">Перейти в каталог <span aria-hidden="true">→</span></a>
    <div class="wk-hero-stats">
      <span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M4.5 6.5l15 11M19.5 6.5l-15 11M5 12h14"/></svg>
        <b>до -30°C</b><small>тепло</small>
      </span>
      <span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10h16M7 7l-3 3 3 3M17 7l3 3-3 3M8 16h8M8 19h8"/></svg>
        <b>2-14 лет</b><small>размеры</small>
      </span>
      <span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 19 6v5c0 5-2.9 8.2-7 10-4.1-1.8-7-5-7-10V6l7-3Z"/><path d="M12 9v5"/></svg>
        <b>мембрана</b><small>защита</small>
      </span>
    </div>
  </div>
  <div class="wk-hero-bottom">
    <div class="wk-dots" aria-label="Слайды">
      <button class="active" type="button" aria-label="Слайд 1" data-slide="0"></button>
      <button type="button" aria-label="Слайд 2" data-slide="1"></button>
      <button type="button" aria-label="Слайд 3" data-slide="2"></button>
    </div>
  </div>
  <div class="wk-weather-card">
    <svg viewBox="0 0 24 24"><path d="M10 14.4V5a2 2 0 0 1 4 0v9.4a5 5 0 1 1-4 0Z"/><path d="M12 17v.1"/></svg>
    <div><span>Тепло и комфорт</span><small>при любой погоде</small></div>
  </div>
</section>

<section class="wk-categories" id="new">
  <div class="wk-section-head">
    <h2><span>✣</span> Зимние куртки</h2>
    <a href="/catalog">Смотреть все <span>→</span></a>
  </div>
  <div class="wk-promo-grid">
    <a class="wk-promo-card boys" href="/catalog?gender=BOYS">
      <strong>Для<br>мальчиков</strong>
      <small>от 2 до 14 лет</small>
      <span class="wk-arrow">→</span>
      <img src="/uploads/promo-jacket-boys.png" alt="">
    </a>
    <a class="wk-promo-card girls" href="/catalog?gender=GIRLS">
      <strong>Для<br>девочек</strong>
      <small>от 2 до 14 лет</small>
      <span class="wk-arrow">→</span>
      <img src="/uploads/promo-jacket-girls.png" alt="">
    </a>
    <a class="wk-promo-card new" href="/catalog?sort=new">
      <strong>Новинки</strong>
      <small>Новые модели<br>этого сезона</small>
      <span class="wk-arrow">→</span>
      <img src="/uploads/promo-jacket-new.png" alt="">
    </a>
    <a class="wk-promo-card sale" href="/catalog?maxPrice=170">
      <strong>Распродажа</strong>
      <small>Скидки до 50%</small>
      <span class="wk-arrow">→</span>
      <img src="/uploads/promo-jacket-sale.png" alt="">
    </a>
  </div>
</section>

<section class="wk-benefits" id="delivery">
  <div>
    <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M7 17h22v16H7z"/><path d="M29 22h7l5 6v5H29z"/><circle cx="15" cy="36" r="4"/><circle cx="35" cy="36" r="4"/></svg>
    <p><b>Быстрая доставка</b><span>по всей России</span></p>
  </div>
  <div>
    <svg viewBox="0 0 48 48" aria-hidden="true"><path d="m24 5 5.2 6 8-.8.8 8 6 5.8-6 5.8-.8 8-8-.8-5.2 6-5.2-6-8 .8-.8-8-6-5.8 6-5.8.8-8 8 .8L24 5Z"/><path d="m16.5 24.5 5 5L32 18"/></svg>
    <p><b>Гарантия качества</b><span>на все товары</span></p>
  </div>
  <div>
    <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M40 22A16 16 0 0 0 13 11l-5 5"/><path d="M8 7v9h9"/><path d="M8 26a16 16 0 0 0 27 11l5-5"/><path d="M40 41v-9h-9"/></svg>
    <p><b>Лёгкий возврат</b><span>в течение 14 дней</span></p>
  </div>
  <div>
    <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 27a14 14 0 0 1 28 0"/><path d="M10 27v7a4 4 0 0 0 4 4h3V24h-3a4 4 0 0 0-4 4Z"/><path d="M38 27v7a4 4 0 0 1-4 4h-3V24h3a4 4 0 0 1 4 4Z"/><path d="M31 38c0 2.5-3.2 4-7 4"/></svg>
    <p><b>Поддержка 24/7</b><span>Мы всегда на связи</span></p>
  </div>
</section>

<section class="wk-new-arrivals" id="about">
  <div class="wk-arrivals-head">
    <h2>
      <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 5v38M9 14l30 20M39 14 9 34M16 6l8 8 8-8M16 42l8-8 8 8M5 24h38M8 18l8 6-8 6M40 18l-8 6 8 6" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Новинки магазина
    </h2>
    <a href="/catalog">Все товары <span>→</span></a>
  </div>
  <div class="wk-arrivals-grid">
    <article class="wk-arrival-card blue">
      <div class="wk-arrival-photo"><img src="/uploads/new-arrival-arctic-blue.png" alt="Куртка Arctic Blue"></div>
      <span class="wk-arrival-badge">Новинка</span>
      <form method="post" action="/favorites/add" class="wk-heart">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="productId" value="<%= newProducts[0]?.id || 1 %>">
        <button type="submit" aria-label="В избранное">♡</button>
      </form>
      <div class="wk-arrival-body">
        <h3>Куртка Arctic Blue</h3>
        <p>Зимняя куртка</p>
        <div class="wk-arrival-price"><strong>159.00 BYN</strong><del>189.00 BYN</del><a href="/catalog">→</a></div>
      </div>
    </article>
    <article class="wk-arrival-card rose">
      <div class="wk-arrival-photo"><img src="/uploads/new-arrival-snow-rose.png" alt="Куртка Snow Rose"></div>
      <span class="wk-arrival-badge">Новинка</span>
      <form method="post" action="/favorites/add" class="wk-heart">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="productId" value="<%= newProducts[1]?.id || 2 %>">
        <button type="submit" aria-label="В избранное">♡</button>
      </form>
      <div class="wk-arrival-body">
        <h3>Куртка Snow Rose</h3>
        <p>Зимняя куртка</p>
        <div class="wk-arrival-price"><strong>149.00 BYN</strong><a href="/catalog">→</a></div>
      </div>
    </article>
    <article class="wk-arrival-card mint">
      <div class="wk-arrival-photo"><img src="/uploads/new-arrival-frost-mint.png" alt="Куртка Frost Mint"></div>
      <span class="wk-arrival-badge hit">Хит</span>
      <form method="post" action="/favorites/add" class="wk-heart">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="productId" value="<%= newProducts[2]?.id || 3 %>">
        <button type="submit" aria-label="В избранное">♡</button>
      </form>
      <div class="wk-arrival-body">
        <h3>Куртка Frost Mint</h3>
        <p>Зимняя куртка</p>
        <div class="wk-arrival-price"><strong>139.00 BYN</strong><a href="/catalog">→</a></div>
      </div>
    </article>
    <article class="wk-arrival-card night">
      <div class="wk-arrival-photo"><img src="/uploads/new-arrival-polar-night.png" alt="Куртка Polar Night"></div>
      <span class="wk-arrival-badge">Новинка</span>
      <form method="post" action="/favorites/add" class="wk-heart">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="productId" value="<%= newProducts[3]?.id || 4 %>">
        <button type="submit" aria-label="В избранное">♡</button>
      </form>
      <div class="wk-arrival-body">
        <h3>Куртка Polar Night</h3>
        <p>Зимняя куртка</p>
        <div class="wk-arrival-price"><strong>169.00 BYN</strong><del>199.00 BYN</del><a href="/catalog">→</a></div>
      </div>
    </article>
  </div>
</section>
